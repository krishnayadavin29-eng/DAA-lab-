
#include <bits/stdc++.h>
using namespace std;

void printBoard(vector<vector<char>>& board, int n) {
    for (int i = 0; i < n; i++) {
        for (int j = 0; j < n; j++) {
            cout << board[i][j] << " ";
        }
        cout << endl;
    }
    cout << endl;
}

bool isSafe(vector<vector<char>>& board, int row, int col, int n) {

    // Check the same column above the current position
    for (int i = 0; i < row; i++) {
        if (board[i][col] == 'Q')
            return false;
    }

    // Check upper-left diagonal
    for (int i = row - 1, j = col - 1;
         i >= 0 && j >= 0; i--, j--) {
        if (board[i][j] == 'Q')
            return false;
    }

    // Check upper-right diagonal
    for (int i = row - 1, j = col + 1;
         i >= 0 && j < n; i--, j++) {
        if (board[i][j] == 'Q')
            return false;
    }

    return true;
}

bool solveNQueens(vector<vector<char>>& board, int row, int n) {

    // All queens have been placed
    if (row == n) {
        printBoard(board, n);
        return true;
    }

    // Try placing a queen in every column of this row
    for (int col = 0; col < n; col++) {

        if (isSafe(board, row, col, n)) {

            board[row][col] = 'Q';  // Place queen

            if (solveNQueens(board, row + 1, n))
                return true;

            board[row][col] = '.';  // Backtrack
        }
    }

    return false;
}

int main() {
    int n;
    cout << "Enter N: ";
    cin >> n;

    vector<vector<char>> board(n, vector<char>(n, '.'));

    if (!solveNQueens(board, 0, n)) {
        cout << "No solution exists\n";
    }

    return 0;
}
