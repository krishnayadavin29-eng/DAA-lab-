#include <iostream>
#include <vector>
#include <algorithm>

using namespace std;

// Structure to represent an activity
struct Activity {
    int id;
    int start;
    int finish;
};

// Comparator function to sort activities in ascending order of their finish times
bool compareActivities(const Activity& a, const Activity& b) {
    return a.finish < b.finish;
}

// Function to select the maximum number of activities
void selectActivities(vector<Activity>& activities) {
    int n = activities.size();
    if (n == 0) return;

    // Step 1: Sort activities based on finish time
    sort(activities.begin(), activities.end(), compareActivities);

    cout << "\nSelected Activities:\n";
    
    // The first activity is always selected
    int lastFinished = 0;
    cout << "Activity " << activities[0].id << " (Start: " << activities[0].start << ", Finish: " << activities[0].finish << ")\n";

    // Step 2: Iterate through the remaining activities
    for (int i = 1; i < n; ++i) {
        // If the start time of the current activity is greater than or equal 
        // to the finish time of the previously selected activity, select it
        if (activities[i].start >= activities[lastFinished].finish) {
            cout << "Activity " << activities[i].id << " (Start: " << activities[i].start << ", Finish: " << activities[i].finish << ")\n";
            lastFinished = i;
        }
    }
}

int main() {
    // Example dataset: {Activity ID, Start Time, Finish Time}
    vector<Activity> activities = {
        {1, 1, 3},
        {2, 2, 5},
        {3, 0, 6},
        {4, 5, 7},
        {5, 8, 9},
        {6, 5, 9}
    };

    cout << "Total activities given: " << activities.size() << "\n";
    selectActivities(activities);

    return 0;
}
