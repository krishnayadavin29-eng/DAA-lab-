
#include <bits/stdc++.h>
using namespace std;

int knapsack(vector<int>& wt, vector<int>& val, int W) {
    int n = wt.size();

    // dp[i][w] = maximum profit using first i items
    // with knapsack capacity w
    vector<vector<int>> dp(n + 1, vector<int>(W + 1, 0));

    for (int i = 1; i <= n; i++) {
        for (int w = 0; w <= W; w++) {

            // Do not take the current item
            dp[i][w] = dp[i - 1][w];

            // Take the current item if it fits
            if (wt[i - 1] <= w) {
                dp[i][w] = max(
                    dp[i][w],
                    val[i - 1] + dp[i - 1][w - wt[i - 1]]
                );
            }
        }
    }

    return dp[n][W];
}

int main() {
    vector<int> wt = {5, 7, 4, 12};
    vector<int> val = {30, 28, 20, 24};
    int W = 11;
    cout << "Maximum profit: "
         << knapsack(wt, val, W) << endl;

    return 0;
}
