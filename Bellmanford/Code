#include <iostream>
#include <vector>
#include <climits>

using namespace std;
 
struct FlatEdge {
    int src;
    int dest;
    int weight;
};

bool bellmanFord(int vertices, const vector<FlatEdge>& edges, int start, vector<int>& dist) {
     
    dist.assign(vertices, INT_MAX);
    dist[start] = 0;

    for (int i = 1; i <= vertices - 1; ++i) {
        for (const auto& edge : edges) {
            int u = edge.src;
            int v = edge.dest;
            int weight = edge.weight;

            if (dist[u] != INT_MAX && dist[u] + weight < dist[v]) {
                dist[v] = dist[u] + weight;
            }
        }
    }

    
    for (const auto& edge : edges) {
        int u = edge.src;
        int v = edge.dest;
        int weight = edge.weight;

        if (dist[u] != INT_MAX && dist[u] + weight < dist[v]) {
            return true;  
        }
    }

    return false;  
}

int main() {
    int vertices = 5;

    
    vector<FlatEdge> standardGraph = {
        {0, 1, 4},   
        {0, 2, 2},   
        {1, 2, -3},  
        {1, 3, 2},  
        {2, 4, 2},   
        {4, 3, -5}   
    };

    // Test Case 2: Graph containing a explicit Negative Weight Cycle (1 -> 2 -> 3 -> 1 totals -2)
    vector<FlatEdge> negativeCycleGraph = {
        {0, 1, 4},
        {1, 2, -1},
        {2, 3, -2},
        {3, 1, 1},  // Loop: -1 + -2 + 1 = -2
        {3, 4, 2}
    };

    int source = 0;
    vector<int> distances;
  
    cout << "=== Bellman-Ford Result (Source: Node " << source << ") ===" << endl;
    if (bellmanFord(vertices, standardGraph, source, distances)) {
        cout << "Graph contains a negative-weight cycle!" << endl;
    } else {
        for (int i = 0; i < vertices; ++i) {
            cout << "Shortest distance from " << source << " to node " << i << " is ";
            if (distances[i] == INT_MAX) cout << "INF" << endl;
            else cout << distances[i] << endl;
        }
    }

 
    cout << "\n=== Bellman-Ford Negative Cycle Verification ===" << endl;
    if (bellmanFord(vertices, negativeCycleGraph, source, distances)) {
        cout << "Alert: A negative-weight cycle was successfully detected in the graph!" << endl;
    } else {
        cout << "No negative-weight cycle found." << endl;
    }

    return 0;
}
